1: SET A(0)=5
2: SET A(1)=2
3: SET A(2)=4
4: SET A(3)=1
5: SET A(4)=3
10: SET N=5
20: SET I=0
30: IF I>=N-1 THEN 160
40: SET J=0
50: IF J>=N-I-1 THEN 130
60: IF A(J)<=A(J+1) THEN 100
70: SET T=A(J)
80: SET A(J)=A(J+1)
90: SET A(J+1)=T
100: SET J=J+1
110: GOTO 50
130: SET I=I+1
140: GOTO 30
160: TYPE A(0),!
170: TYPE A(1),!
180: TYPE A(2),!
190: TYPE A(3),!
200: TYPE A(4),!
210: QUIT
